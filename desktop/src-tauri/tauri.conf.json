{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toget",
  "version": "0.1.0",
  "identifier": "dev.toget.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:7718",
    "beforeBuildCommand": "",
    "frontendDist": "../../web/app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Toget",
        "url": "http://127.0.0.1:7718",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../web/app/public/icons/icon-192.png",
      "../../web/app/public/icons/icon-512.png"
    ]
  }
}
