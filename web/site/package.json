{
  "name": "@toget/site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm wasm && vite",
    "build": "pnpm wasm && tsc --noEmit && vite build",
    "preview": "vite preview",
    "wasm": "mkdir -p public/wasm && GOOS=js GOARCH=wasm go build -trimpath -o public/wasm/toget-site.wasm ./wasm && cp \"$(go env GOROOT)/lib/wasm/wasm_exec.js\" public/wasm/wasm_exec.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
